# =============================================
# PM-Insight-Hub Environment Configuration
# =============================================

# --- Slack Configuration ---
# Bot token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing secret from Slack app settings
SLACK_SIGNING_SECRET=your-signing-secret
# App-level token for Socket Mode (starts with xapp-)
# Only needed for local development with Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
# service_role key (Settings > API > Project API keys) — NOT the anon key.
# This bypasses RLS, so keep it server-side only, never in client/browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your-gemini-api-key

# --- ClickUp Configuration ---
CLICKUP_WEBHOOK_SECRET=your-clickup-webhook-secret
CLICKUP_API_TOKEN=your-clickup-api-token

# --- Access Control ---
# Slack user IDs (comma-separated) allowed to ask about the bot's own
# implementation — models, prompts, storage, infrastructure. Everyone else gets
# a decline. Unset means nobody is trusted, which fails closed on purpose.
ADMIN_SLACK_USER_IDS=U01234567

# --- Server Configuration ---
# In production (SOCKET_MODE=false), Slack events AND the ClickUp
# webhook are both served from this single port.
PORT=3000

# --- Mode Configuration ---
# Set to 'true' for local development with Socket Mode
# Set to 'false' or omit for production HTTP mode
SOCKET_MODE=true

# --- Dashboard ---
# Shared secret for the web dashboard at /dashboard.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Unset disables the dashboard entirely (fails closed).
DASHBOARD_TOKEN=
