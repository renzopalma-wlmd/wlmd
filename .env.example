# =============================================
# PM-Insight-Hub Environment Configuration
# =============================================

# --- Slack Configuration ---
# Bot token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing secret from Slack app settings
SLACK_SIGNING_SECRET=your-signing-secret
# App-level token for Socket Mode (starts with xapp-)
# Only needed for local development with Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your-gemini-api-key

# --- ClickUp Configuration ---
CLICKUP_WEBHOOK_SECRET=your-clickup-webhook-secret
CLICKUP_API_TOKEN=your-clickup-api-token

# --- Server Configuration ---
# In production (SOCKET_MODE=false), Slack events AND the ClickUp
# webhook are both served from this single port.
PORT=3000

# --- Mode Configuration ---
# Set to 'true' for local development with Socket Mode
# Set to 'false' or omit for production HTTP mode
SOCKET_MODE=true
